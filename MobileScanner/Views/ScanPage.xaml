<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MobileScanner.Views.ScanPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
             Title="MobileScanner - By Alexis Guyennon"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">

            <!-- Top Row: Camera + Logo/Controls -->
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="15" HeightRequest="280">

                <!-- Camera -->
                <Border Grid.Column="0"
                        StrokeThickness="3"
                        Stroke="#9C27B0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="Black">
                    <zxing:CameraBarcodeReaderView x:Name="CameraView"
                                                   IsDetecting="True"
                                                   BarcodesDetected="CameraView_BarcodesDetected"/>
                </Border>

                <!-- Right Side: Logo + Mode Switch -->
                <VerticalStackLayout Grid.Column="1" Spacing="15" VerticalOptions="Start">

                    <!-- Logo Area -->
                    <Border StrokeThickness="2"
                            Stroke="#9C27B0"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="#1E1E1E"
                            HeightRequest="120"
                            Padding="10">
                        <Label Text="MOBILE&#x0a;SCANNER"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#9C27B0"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                    </Border>

                    <!-- Mode Toggle -->
                    <Border StrokeThickness="1"
                            Stroke="#9C27B0"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="#1E1E1E"
                            Padding="10"
                            HeightRequest="80">
                        <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="Scan Mode --- Text Mode" 
                                   TextColor="White" 
                                   FontSize="11"
                                   HorizontalOptions="Center"/>
                            <Switch x:Name="ModeSwitch" 
                                    ThumbColor="#9C27B0" 
                                    OnColor="Green"
                                    HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Grid>

            <!-- Capture Text Button (for Text Mode) -->
            <Button x:Name="CaptureButton"
                    Text="📷 CAPTURE TEXT TO SCAN"
                    BackgroundColor="Green"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="60"
                    FontSize="14"
                    IsVisible="False"
                    Clicked="OnCaptureClicked"/>

            <!-- Input Row: Code + Qty + Copy + Clear + Unit + Auto Login -->
            <Grid ColumnDefinitions="1.5*,Auto,Auto,Auto,*,Auto" ColumnSpacing="6">

                <Entry x:Name="BarcodeEntry"
                       Grid.Column="0"
                       Placeholder="CODE"
                       TextColor="Black"
                       BackgroundColor="White"
                       FontSize="14"
                       HeightRequest="45"
                       VerticalTextAlignment="Center"/>

                <Entry x:Name="QuantityEntry"
                       Grid.Column="1"
                       Placeholder="QTY"
                       Keyboard="Numeric"
                       WidthRequest="55"
                       BackgroundColor="White"
                       TextColor="Black"
                       FontSize="14"
                       HeightRequest="45"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>

                <Button x:Name="ScanCopyButton"
                        Grid.Column="2"
                        Text="COPY"
                        BackgroundColor="#9C27B0"
                        TextColor="White"
                        FontAttributes="Bold"
                        WidthRequest="65"
                        HeightRequest="45"
                        FontSize="11"
                        Clicked="OnCopyClicked"/>

                <Button x:Name="ClearButton"
                        Grid.Column="3"
                        Text="CLEAR"
                        BackgroundColor="#F44336"
                        TextColor="White"
                        FontAttributes="Bold"
                        WidthRequest="65"
                        HeightRequest="45"
                        FontSize="11"/>

                <Picker x:Name="UnitPicker"
                        Grid.Column="4"
                        Title="Unit"
                        TextColor="Black"
                        BackgroundColor="White"
                        FontSize="12"
                        HeightRequest="45"
                        VerticalOptions="Center"/>

                <Button x:Name="AutoLoginButton"
                        Grid.Column="5"
                        Text="AUTOMATE"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        FontAttributes="Bold"
                        WidthRequest="95"
                        HeightRequest="45"
                        FontSize="10"
                        Clicked="OnAutoLoginClicked"/>
            </Grid>

            <!-- MAIN MENU -->
            <StackLayout x:Name="MainMenu" Spacing="12" Margin="0,5,0,0">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="THIRD-PARTY"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="60"
                            FontSize="13"
                            Clicked="OnThirdPartyClicked"/>
                    <Button Grid.Column="1"
                            Text="HISTORY"
                            BackgroundColor="#FF9800"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="60"
                            FontSize="13"
                            Clicked="OnHistoryMenuClicked"/>
                    <Button Grid.Column="2"
                            Text="PC AUTOMATION"
                            BackgroundColor="#2196F3"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="60"
                            FontSize="13"
                            Clicked="OnPcAutomationClicked"/>
                </Grid>
            </StackLayout>

            <!-- THIRD-PARTY MENU -->
            <StackLayout x:Name="ThirdPartyMenu" IsVisible="False" Opacity="0" Spacing="12" Padding="10">
                <Label Text="Third-Party Tools"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#4CAF50"
                       HorizontalOptions="Center"/>
                <Button Text="SEND TO PDF"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        HeightRequest="50"
                        Clicked="OnCreatePdfClicked"/>
                <Button Text="SEND TO EXCEL"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        HeightRequest="50"
                        Clicked="OnSendExcelClicked"/>
                <Button Text="BACK"
                        BackgroundColor="#9E9E9E"
                        TextColor="White"
                        HeightRequest="50"
                        Clicked="OnBackClicked"/>
            </StackLayout>

            <!-- HISTORY MENU -->
            <StackLayout x:Name="HistoryMenu" IsVisible="False" Opacity="0" Spacing="12" Padding="10">
                <Label Text="History Management"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#FF9800"
                       HorizontalOptions="Center"/>

                <Label Text="Group History" TextColor="#FF9800" FontAttributes="Bold" FontSize="14"/>
                <Button Text="VIEW / ADD QTY"
                        BackgroundColor="#FF9800"
                        TextColor="White"
                        HeightRequest="50"
                        Clicked="OnGroupHistoryClicked"/>
                <Button x:Name="CopyGroupHistoryButton"
                        Text="COPY GROUP HISTORY"
                        BackgroundColor="#FF9800"
                        TextColor="White"
                        HeightRequest="50"
                        Clicked="OnCopyGroupHistoryClicked"/>

                <Label Text="Single History" TextColor="#FF9800" FontAttributes="Bold" FontSize="14" Margin="0,10,0,0"/>
                <Button Text="VIEW HISTORY"
                        BackgroundColor="#FF9800"
                        TextColor="White"
                        HeightRequest="50"
                        Clicked="OnHistoryClicked"/>
                <Button Text="COPY SINGLE"
                        BackgroundColor="#FF9800"
                        TextColor="White"
                        HeightRequest="50"
                        Clicked="OnCopyAllClicked"/>

                <Button Text="BACK"
                        BackgroundColor="#9E9E9E"
                        TextColor="White"
                        HeightRequest="50"
                        Clicked="OnBackClicked"/>
            </StackLayout>

            <!-- PC AUTOMATION MENU -->
            <StackLayout x:Name="PcAutomationMenu" IsVisible="False" Opacity="0" Spacing="12" Padding="10">
                <Label Text="PC Automation"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#2196F3"
                       HorizontalOptions="Center"/>

                <!-- Fenêtres dropdown -->
                <toolkit:Expander>
                    <toolkit:Expander.Header>
                        <Frame BackgroundColor="#1976D2" Padding="12" CornerRadius="8" HasShadow="False">
                            <Label Text="Fenêtres"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   HorizontalOptions="Center"/>
                        </Frame>
                    </toolkit:Expander.Header>
                    <VerticalStackLayout Spacing="8" Padding="5">
                        <Button Text="EXTRUSIONS" Clicked="OnExtrusionsClicked"
                                BackgroundColor="#2196F3" TextColor="White" HeightRequest="45"/>
                        <Button Text="QUINCAILLERIE" Clicked="OnQuincaillerieClicked"
                                BackgroundColor="#2196F3" TextColor="White" HeightRequest="45"/>
                        <Button Text="BOIS (FENÊTRES)" Clicked="OnFenetresBoisClicked"
                                BackgroundColor="#2196F3" TextColor="White" HeightRequest="45"/>
                    </VerticalStackLayout>
                </toolkit:Expander>

                <!-- Portes dropdown -->
                <toolkit:Expander>
                    <toolkit:Expander.Header>
                        <Frame BackgroundColor="#1976D2" Padding="12" CornerRadius="8" HasShadow="False">
                            <Label Text="Portes"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   HorizontalOptions="Center"/>
                        </Frame>
                    </toolkit:Expander.Header>
                    <VerticalStackLayout Spacing="8" Padding="5">
                        <Button Text="SLAB" Clicked="OnSlabClicked"
                                BackgroundColor="#2196F3" TextColor="White" HeightRequest="45"/>
                        <Button Text="GLAZING" Clicked="OnGlazingClicked"
                                BackgroundColor="#2196F3" TextColor="White" HeightRequest="45"/>
                        <Button Text="COMPOSANTES" Clicked="OnComposantesClicked"
                                BackgroundColor="#2196F3" TextColor="White" HeightRequest="45"/>
                        <Button Text="BOIS (PORTES)" Clicked="OnPorteBoisClicked"
                                BackgroundColor="#2196F3" TextColor="White" HeightRequest="45"/>
                    </VerticalStackLayout>
                </toolkit:Expander>

                <Button Text="BACK"
                        BackgroundColor="#9E9E9E"
                        TextColor="White"
                        HeightRequest="50"
                        Clicked="OnBackClicked"/>
            </StackLayout>

            <!-- Status Label -->
            <Border BackgroundColor="#1E1E1E"
                    StrokeShape="RoundRectangle 8"
                    Stroke="#9C27B0"
                    StrokeThickness="2"
                    Padding="15"
                    Margin="0,5,0,10">
                <Label x:Name="StatusLabel"
                       Text="READY TO SCAN..."
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#9C27B0"
                       HorizontalTextAlignment="Center"/>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>